Phase 1: Terraform Infrastructure Setup
We will start by writing the 7 core files for your environment configuration (environments/prod/), utilizing reusable modules (modules/vpc/ and modules/ec2/).

Step 1: Create the VPC Module Files
Inside your modules/vpc/ directory, create your three module files:

modules/vpc/main.tf:

Terraform
resource "aws_vpc" "main" {
  cidr_block           = var.vpc_cidr
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name = "${var.environment}-vpc"
  }
}

resource "aws_internet_gateway" "gw" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "${var.environment}-igw"
  }
}

resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = var.public_subnet_cidr
  map_public_ip_on_launch = true

  tags = {
    Name = "${var.environment}-public-subnet"
  }
}

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.gw.id
  }

  tags = {
    Name = "${var.environment}-public-rt"
  }
}

resource "aws_route_table_association" "public" {
  subnet_id      = aws_subnet.public.id
  route_table_id = aws_route_table.public.id
}
Verification: Run terraform validate inside the module folder later to ensure valid HCL syntax.

modules/vpc/variables.tf:

Terraform
variable "environment" {
  type = string
}

variable "vpc_cidr" {
  type    = string
  default = "10.0.0.0/16"
}

variable "public_subnet_cidr" {
  type    = string
  default = "10.0.1.0/24"
}
modules/vpc/outputs.tf:

Terraform
output "vpc_id" {
  value = aws_vpc.main.id
}

output "public_subnet_id" {
  value = aws_subnet.public.id
}
Step 2: Create the EC2 Compute Module Files
Inside your modules/ec2/ directory, create your compute module files:

modules/ec2/main.tf:

Terraform
resource "aws_security_group" "app" {
  name        = "${var.environment}-app-sg"
  description = "Allow SSH and application traffic"
  vpc_id      = var.vpc_id

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"] # Restrict to your IP in production
  }

  ingress {
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.environment}-sg"
  }
}

resource "aws_instance" "server" {
  ami                    = var.ami_id
  instance_type          = var.instance_type
  subnet_id              = var.subnet_id
  vpc_security_group_ids = [aws_security_group.app.id]

  tags = {
    Name = "${var.environment}-server"
  }
}
modules/ec2/variables.tf:

Terraform
variable "environment" { type = string }
variable "vpc_id" { type = string }
variable "subnet_id" { type = string }
variable "ami_id" { type = string }
variable "instance_type" { type = string }
modules/ec2/outputs.tf:

Terraform
output "instance_ip" {
  value = aws_instance.server.public_ip
}
Step 3: Create the 7 Root Production Environment Files
Inside your environments/prod/ folder, create the complete environment file set:

environments/prod/providers.tf:

Terraform
provider "aws" {
  region = "us-east-1"
}
environments/prod/versions.tf:

Terraform
terraform {
  required_version = ">= 1.6.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}
environments/prod/backend.tf:

Terraform
terraform {
  backend "s3" {
    bucket         = "my-company-terraform-state-prod"
    key            = "infrastructure/prod/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "terraform-state-locks-prod"
    encrypt        = true
  }
}
environments/prod/variables.tf:

Terraform
variable "instance_type" {
  type    = string
  default = "t3.medium"
}
environments/prod/terraform.tfvars:

Terraform
instance_type = "t3.medium"
environments/prod/main.tf:

Terraform
module "prod_vpc" {
  source             = "../../modules/vpc"
  environment        = "prod"
  vpc_cidr           = "10.100.0.0/16"
  public_subnet_cidr = "10.100.1.0/24"
}

module "prod_ec2" {
  source        = "../../modules/ec2"
  environment   = "prod"
  vpc_id        = module.prod_vpc.vpc_id
  subnet_id     = module.prod_vpc.public_subnet_id
  ami_id        = "ami-04a81a99f5ec58529" # Ubuntu 24.04 LTS AMI
  instance_type = var.instance_type
}
environments/prod/outputs.tf:

Terraform
output "production_server_ip" {
  value = module.prod_ec2.instance_ip
}
